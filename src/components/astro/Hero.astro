---
---

<section class="relative min-h-[82vh] flex items-center justify-center text-center overflow-hidden bg-[#1C3200] text-white px-6 sm:px-8 py-24 sm:py-32 border-b border-white/10">
  
  <!-- Full-bleed Real Service Image Background -->
  <img
    src="/src/assets/images/thumbnail/header-bg.jpeg"
    alt="Fumigasi Hyrdan Pest"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <!-- Minimalist Deep Pine Gradient Overlay (#1C3200 from Adobe Palette) -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#1C3200]/92 via-[#1C3200]/82 to-[#1C3200]/95 pointer-events-none"></div>

  <!-- Subtle Micro Grid for Tactile Depth -->
  <div 
    class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 32px 32px;"
  ></div>

  <!-- Main Minimalist Content Container -->
  <div class="relative max-w-4xl mx-auto z-10 flex flex-col items-center">
    
    <!-- Minimalist Tagline -->
    <span class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-[#5EA500] mb-4">
      Fumigation & Pest Control Services
    </span>

    <!-- Minimalist Bold Headline -->
    <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15] mb-6">
      Industry-Standard Pest Control & Fumigation Solutions.
    </h1>

    <!-- Clean & Breathable Subtitle -->
    <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed mb-10 font-normal">
      Complete protection against termites, rodents, and pests for residential properties, commercial offices, and industrial facilities with eco-safe technology.
    </p>

    <!-- Minimalist Action Group -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto mb-14">
      
      <!-- Primary CTA (Action Orange #FF7A00) -->
      <a
        href="/contact"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#FF7A00] hover:bg-[#e66e00] text-white font-heading font-semibold text-sm sm:text-base px-8 py-3.5 rounded-lg shadow-sm hover:-translate-y-0.5 transition-all text-center"
      >
        <span>Get A Free Quote</span>
        <span>→</span>
      </a>

      <!-- Secondary CTA (Minimalist Border) -->
      <a
        href="/services"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/[0.05] hover:bg-white/10 text-white font-heading font-medium text-sm sm:text-base px-7 py-3.5 rounded-lg border border-white/20 hover:border-white/35 transition-all text-center"
      >
        <span>Explore Services</span>
      </a>

    </div>

    <!-- Minimal Trust Strip -->
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 pt-8 border-t border-white/15 text-xs sm:text-sm text-white/70 font-medium">
      <div class="flex items-center gap-2">
        <span class="text-[#5EA500]">✓</span>
        <span>100% Guaranteed Elimination</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[#5EA500]">✓</span>
        <span>Eco-Friendly & Safe Chemicals</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[#5EA500]">✓</span>
        <span>24/7 Rapid Response</span>
      </div>
    </div>

  </div>

</section>