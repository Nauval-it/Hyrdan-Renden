---
---

<section class="bg-[#F8FBF4] text-[#1C3200] py-20 lg:py-28 px-6 sm:px-8 border-b border-[#1C3200]/10">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 sm:mb-20">
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#1C3200] mb-4">
        Who We Are
      </h2>
      <p class="text-sm sm:text-base font-semibold text-[#5EA500] tracking-wide mb-6">
        Setting the Standard in Safe & Certified Pest Defense.
      </p>
      <p class="text-base sm:text-lg text-[#1C3200]/75 leading-relaxed font-normal">
        Hyrdan Pest delivers licensed fumigation and integrated pest management services across Indonesia. We combine certified chemical safety with proven field methodologies to protect residential homes, corporate offices, and commercial facilities — ensuring safety, compliance, and lasting peace of mind.
      </p>
    </div>

    <!-- 4 Minimalist Pillars -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Pillar 1: Eco-Safe Standards -->
      <div class="bg-white p-7 rounded-2xl border border-[#1C3200]/10 hover:border-[#5EA500]/40 transition-colors flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#5EA500]/10 text-[#5EA500] flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-[#1C3200] mb-2">
            Eco-Safe Standards
          </h3>
          <p class="text-xs sm:text-sm text-[#1C3200]/70 leading-relaxed">
            Formulated with non-hazardous chemicals safe for children, pets, and sensitive food preparation areas.
          </p>
        </div>
      </div>

      <!-- Pillar 2: Licensed Experts -->
      <div class="bg-white p-7 rounded-2xl border border-[#1C3200]/10 hover:border-[#5EA500]/40 transition-colors flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#5EA500]/10 text-[#5EA500] flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-[#1C3200] mb-2">
            Licensed Experts
          </h3>
          <p class="text-xs sm:text-sm text-[#1C3200]/70 leading-relaxed">
            ASPPHAMI-accredited technicians operating with rigorous protocols and international standards.
          </p>
        </div>
      </div>

      <!-- Pillar 3: Rapid Dispatch -->
      <div class="bg-white p-7 rounded-2xl border border-[#1C3200]/10 hover:border-[#5EA500]/40 transition-colors flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#5EA500]/10 text-[#5EA500] flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-[#1C3200] mb-2">
            Rapid Dispatch
          </h3>
          <p class="text-xs sm:text-sm text-[#1C3200]/70 leading-relaxed">
            Swift emergency response teams ready for dispatch within 2 hours for urgent property infestations.
          </p>
        </div>
      </div>

      <!-- Pillar 4: 100% Guaranteed -->
      <div class="bg-white p-7 rounded-2xl border border-[#1C3200]/10 hover:border-[#5EA500]/40 transition-colors flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#5EA500]/10 text-[#5EA500] flex items-center justify-center mb-5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-base text-[#1C3200] mb-2">
            100% Guaranteed
          </h3>
          <p class="text-xs sm:text-sm text-[#1C3200]/70 leading-relaxed">
            Complete eradication warranty with complimentary re-inspections within 30 days of treatment.
          </p>
        </div>
      </div>

    </div>

    <!-- Minimalist Bottom Link -->
    <div class="text-center mt-14">
      <a
        href="/about"
        class="inline-flex items-center gap-2 font-heading font-semibold text-sm text-[#1C3200] hover:text-[#5EA500] transition-colors group"
      >
        <span>Learn more about our company</span>
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

  </div>
</section>