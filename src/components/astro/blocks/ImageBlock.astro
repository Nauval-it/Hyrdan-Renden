---
interface Props {
  src: string;
  caption?: string;
}
const { src, caption } = Astro.props;
---
<figure class="my-8">
  <img src={src} alt={caption ?? ''} class="w-full rounded-lg" />
  {caption && (
    <figcaption class="text-sm text-gray-500 dark:text-gray-400 text-center mt-2">
      {caption}
    </figcaption>
  )}
</figure>