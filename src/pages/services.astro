---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';

const services = [
  {
    title: 'Termite Control',
    icon: '🐜',
    description: 'Placeholder: full description of termite inspection and treatment process.',
    benefits: ['Protects structural integrity', 'Early detection prevents costly damage', 'Safe for occupants'],
  },
  {
    title: 'Rodent Control',
    icon: '🐀',
    description: 'Placeholder: full description of rodent removal and prevention process.',
    benefits: ['Eliminates health risks', 'Prevents property damage', 'Long-term prevention plans'],
  },
  {
    title: 'Bed Bug Treatment',
    icon: '🛏️',
    description: 'Placeholder: full description of bed bug treatment process.',
    benefits: ['Discreet service', 'Thorough elimination', 'Follow-up inspection included'],
  },
];
---

<head>
  <title>Our Services | Hyrdan Pest</title>
  <meta name="description" content="Explore the range of pest control services offered by HYRDAN PEST. Learn about our termite, rodent, and bed bug treatments." />  
</head>

<BaseLayout>
  <Header />
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="font-heading text-4xl font-bold text-center text-gray-900 dark:text-white mb-4">
      Our Services
    </h1>
    <p class="text-center text-gray-600 dark:text-gray-300 mb-16 max-w-2xl mx-auto">
      Placeholder intro paragraph about the range of services offered.
    </p>

    <div class="space-y-12">
      {services.map((service) => (
        <div class="flex flex-col md:flex-row gap-6 items-start bg-gray-50 dark:bg-gray-800/50 rounded-xl p-8">
          <div class="text-5xl">{service.icon}</div>
          <div class="flex-1">
            <h2 class="font-heading text-2xl font-bold text-gray-900 dark:text-white mb-2">
              {service.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              {service.description}
            </p>
            <ul class="space-y-1">
              {service.benefits.map((benefit) => (
                <li class="text-sm text-gray-700 dark:text-gray-300 flex items-center gap-2">
                  <span class="text-brand">✓</span> {benefit}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-16">
      <a href="/contact" class="inline-block bg-brand hover:bg-brand-dark text-white font-heading font-semibold px-8 py-3 rounded-lg transition">
        Request a Quote
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>