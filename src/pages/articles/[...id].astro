---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
import BlockRenderer from '../../components/astro/blocks/BlockRenderer.astro';
import { getCollection, render } from 'astro:content';
import ArticleSidebar from '../../components/astro/ArticleSidebar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { title, date, category, coverImage, tags, author, blocks } = article.data;

// Auto-calculate read time from all text content in the blocks
function countWords(text: string) {
  return text.trim().split(/\s+/).length;
}

let totalWords = 0;
for (const block of blocks) {
  if (block.type === 'heading' || block.type === 'paragraph') totalWords += countWords(block.text);
  if (block.type === 'quote') totalWords += countWords(block.text);
  if (block.type === 'list') totalWords += block.items.reduce((sum, item) => sum + countWords(item), 0);
  if (block.type === 'twoColumn') totalWords += countWords(block.left) + countWords(block.right);
}
const readTime = Math.max(1, Math.round(totalWords / 200));

const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<head>
  <title>{title} | Hyrdan Pest</title>
  <meta name="description" content={article.data.excerpt} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={article.data.excerpt} />
  <meta property="og:image" content={coverImage} />
  <meta property="og:type" content="article" />
  <meta property="article:published_time" content={date.toISOString()} />
  <meta property="article:author" content={author.name} />
  <meta property="article:tag" content={tags.join(', ')} />
</head>

<BaseLayout>
  <Header />

    <main class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-12">
    <div>
      <div class="flex items-center gap-3 text-sm mb-4">
        <span class="text-brand font-semibold uppercase tracking-wide">{category}</span>
        <span class="text-gray-400">|</span>
        <span class="text-gray-600 dark:text-gray-400">{formattedDate}</span>
        <span class="text-gray-400">|</span>
        <span class="text-gray-600 dark:text-gray-400">{readTime} min read</span>
      </div>

      <h1 class="font-heading text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8 leading-tight">
        {title}
      </h1>

      <img src={coverImage} alt={title} class="w-full rounded-xl mb-10" />

      <div>
        {blocks.map((block) => <BlockRenderer block={block} />)}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 dark:border-gray-700 pt-6 mt-10">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300">
              #{tag}
            </span>
          ))}
        </div>
        <div class="flex gap-3 text-gray-500 dark:text-gray-400">
          <span class="text-sm">Share:</span>
          <a href={`https://facebook.com/sharer/sharer.php?u=${Astro.url}`} aria-label="Share on Facebook">f</a>
          <a href={`https://twitter.com/intent/tweet?url=${Astro.url}`} aria-label="Share on Twitter">x</a>
          <a href={`https://linkedin.com/sharing/share-offsite/?url=${Astro.url}`} aria-label="Share on LinkedIn">in</a>
        </div>
      </div>

      <div class="flex gap-4 bg-gray-50 dark:bg-gray-800/50 rounded-xl p-6 mt-8">
        <img src={author.avatar} alt={author.name} class="w-14 h-14 rounded-full object-cover flex-shrink-0" />
        <div>
          <h3 class="font-heading font-semibold text-gray-900 dark:text-white">{author.name}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">{author.bio}</p>
        </div>
      </div>
    </div>

    <ArticleSidebar activeCategory={category} currentId={article.id} />
  </main>

  <Footer />
</BaseLayout>